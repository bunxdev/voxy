#!/usr/bin/env bash
set -euo pipefail
ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
cd "$ROOT"
source "$ROOT/image.lock"
CACHE="$ROOT/.cache"
STATE="$ROOT/.runtime"
PORT=22222
BASE="$CACHE/debian.qcow2"
DISK="$STATE/debian.qcow2"
mkdir -p "$CACHE" "$STATE"
chmod 700 "$STATE"
ssh_vm() {
  ssh -i "$STATE/id_ed25519" -p "$PORT" -o IdentitiesOnly=yes -o BatchMode=yes \
    -o ConnectTimeout=3 -o StrictHostKeyChecking=accept-new \
    -o UserKnownHostsFile="$STATE/known_hosts" voxy@127.0.0.1 "$@"
}
running() {
  [[ -f "$STATE/qemu.pid" ]] || return 1
  local pid
  read -r pid < "$STATE/qemu.pid"
  [[ "$pid" =~ ^[0-9]+$ && -r "/proc/$pid/cmdline" ]] || return 1
  grep -zFq -- "$DISK" "/proc/$pid/cmdline"
}
fetch() {
  if [[ ! -f "$BASE" ]]; then
    curl --fail --location --retry 3 "$IMAGE_URL" -o "$BASE.part"
    printf '%s  %s\n' "$IMAGE_SHA512" "$BASE.part" | sha512sum -c -
    mv "$BASE.part" "$BASE"
    chmod 444 "$BASE"
  else
    printf '%s  %s\n' "$IMAGE_SHA512" "$BASE" | sha512sum -c -
  fi
}
init() {
  [[ ! -f "$DISK" ]] || { echo 'VM ya inicializada'; return; }
  fetch
  [[ -f "$STATE/id_ed25519" ]] || ssh-keygen -q -t ed25519 -N '' -f "$STATE/id_ed25519"
  cat > "$STATE/user-data" <<CLOUD
#cloud-config
hostname: voxy
manage_etc_hosts: true
users:
  - name: voxy
    groups: [sudo]
    shell: /bin/bash
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    lock_passwd: true
    ssh_authorized_keys:
      - $(cat "$STATE/id_ed25519.pub")
ssh_pwauth: false
disable_root: true
package_update: false
runcmd:
  - [systemctl, set-default, multi-user.target]
CLOUD
  printf 'instance-id: voxy-%s\nlocal-hostname: voxy\n' "$(date +%s)" > "$STATE/meta-data"
  cloud-localds "$STATE/seed.img" "$STATE/user-data" "$STATE/meta-data"
  qemu-img create -f qcow2 -F qcow2 -b "$BASE" "$DISK" 8G
}
start() {
  running && { echo 'Voxy ya está encendido'; return; }
  [[ -f "$DISK" ]] || init
  local accel=${VOXY_ACCEL:-kvm}
  [[ "$accel" == kvm || "$accel" == tcg ]] || { echo 'VOXY_ACCEL debe ser kvm o tcg' >&2; exit 1; }
  qemu-system-x86_64 -name voxy -machine q35 -accel "$accel" \
    -m 768 -smp 1 -display none -monitor none \
    -drive "file=$DISK,format=qcow2,if=virtio" \
    -drive "file=$STATE/seed.img,format=raw,if=virtio,readonly=on" \
    -device virtio-net-pci,netdev=net0 \
    -netdev "user,id=net0,hostfwd=tcp:127.0.0.1:$PORT-:22" \
    -serial "file:$STATE/serial.log" -pidfile "$STATE/qemu.pid" -daemonize 9>&-
  printf '%s\n' "$accel" > "$STATE/accelerator"
  echo "Voxy iniciado ($accel); SSH 127.0.0.1:$PORT"
}
wait_ready() {
  for ((i=0;i<120;i++)); do
    running || { echo 'QEMU no está ejecutándose' >&2; return 1; }
    if ssh_vm 'test -f /var/lib/cloud/instance/boot-finished' >/dev/null 2>&1; then return; fi
    sleep 2
  done
  echo "El invitado no estuvo listo a tiempo; revisa $STATE/serial.log" >&2
  return 1
}
stop() {
  running || { echo 'Voxy apagado'; return; }
  ssh_vm 'sudo systemctl poweroff' || true
  for ((i=0;i<60;i++)); do
    running || { echo 'Voxy apagado'; return; }
    sleep 1
  done
  echo 'No se confirmó el apagado; no se forzó la terminación.' >&2
  return 1
}
# Serializa los cambios sobre el disco y el proceso.
case "${1:-help}" in
  fetch|init|start|stop|test) exec 9>"$STATE/control.lock"; flock -n 9 || { echo 'Otra operación está en curso' >&2; exit 1; };;
esac
case "${1:-help}" in
  fetch) fetch;;
  init) init;;
  start) start;;
  wait) wait_ready;;
  ssh) shift; ssh_vm "$@";;
  stop) stop;;
  status) if running; then echo "Voxy encendido ($(cat "$STATE/accelerator")); PID $(cat "$STATE/qemu.pid")"; else echo 'Voxy apagado'; fi;;
  test)
    start
    wait_ready
    ssh_vm 'set -eu; . /etc/os-release; test "$ID" = debian; test "$VERSION_ID" = 13; test "$(uname -m)" = x86_64; sudo cloud-init status --wait; getent hosts deb.debian.org; ! command -v docker; test "$(systemctl get-default)" = multi-user.target; echo persistencia-voxy | sudo tee /var/lib/voxy-test; cat /etc/debian_version; free -m; df -h /'
    stop
    start
    wait_ready
    ssh_vm 'test "$(cat /var/lib/voxy-test)" = persistencia-voxy && echo "PASS: Debian 13, SSH, DNS y persistencia tras reinicio"'
    ;;
  *) echo 'Uso: ./voxy {fetch|init|start|wait|ssh [comando]|status|stop|test}';;
esac
